# RegimeFlex Environment Configuration
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to version control

# ============================================
# Alpaca Markets API (Paper Trading)
# ============================================
# Get your keys from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_KEY=your_paper_trading_key_here
ALPACA_SECRET=your_paper_trading_secret_here

# Alpaca Base URL (usually auto-detected, override if needed)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ============================================
# Alpaca Markets API (Live Trading)
# ============================================
# WARNING: Only use live keys in production with proper safeguards
# Get your keys from: https://app.alpaca.markets/live/dashboard/overview
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# ============================================
# Polygon.io Market Data API
# ============================================
# Optional but recommended for better data quality
# Get your key from: https://polygon.io/dashboard/api-keys
POLYGON_KEY=your_polygon_api_key_here

# ============================================
# Telegram Notifications (Optional)
# ============================================
# Create a bot: https://core.telegram.org/bots/tutorial
# Get your chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================
# Guardian Module (Optional)
# ============================================
# Discord webhook for emergency alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# Phone number for SMS alerts (Twilio integration)
GUARDIAN_EMERGENCY_PHONE=+1234567890

# ============================================
# Environment
# ============================================
# Set to 'prod' for live trading, 'dev' for development
ENV=dev

